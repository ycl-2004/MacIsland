    "When off, the original moves to the Trash after a successful conversion, so you can still restore it. The same switch is in the Convert tab.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the original moves to the Trash after a successful conversion, so you can still restore it. The same switch is in the Convert tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，转换成功时原文件会移到废纸篓，仍可从中恢复。刘海的“转换”页里也有同一个开关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，轉換成功時原始檔案會移到垃圾桶，仍可從中復原。瀏海的「轉換」頁裡也有同一個開關。"
          }
        }
      }
    },
    "File Convert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File Convert"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件转换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案轉換"
          }
        }
      }
    },
    "Adds a Convert tab to the notch. Drop files there and choose a format. The result is saved in the same folder as the original; existing files are never replaced.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a Convert tab to the notch. Drop files there and choose a format. The result is saved in the same folder as the original; existing files are never replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海中加入“转换”页。把文件拖进去并选择格式，结果会存在原文件所在的文件夹，不会覆盖已有文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏海中加入「轉換」頁。把檔案拖進去並選擇格式，結果會存在原始檔案所在的檔案夾，不會覆寫既有檔案。"
          }
        }
      }
    },
