          "stringUnit": {
            "state": "translated",
            "value": "Images, PDFs, documents, audio and video. Saved next to the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持图片、PDF、文档、音频和视频，结果存在原文件旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援圖片、PDF、文件、音訊和影片，結果存在原始檔案旁邊。"
