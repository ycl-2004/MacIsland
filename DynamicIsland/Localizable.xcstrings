    "Can’t save in this folder. Allow access in System Settings › Privacy & Security › Files and Folders.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t save in this folder. Allow access in System Settings › Privacy & Security › Files and Folders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存到这个文件夹。请在“系统设置 › 隐私与安全性 › 文件与文件夹”中允许访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存到這個檔案夾。請在「系統設定 › 隱私權與安全性 › 檔案與檔案夾」中允許取用。"
          }
