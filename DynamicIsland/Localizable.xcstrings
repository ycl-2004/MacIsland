    "Your calendar data is only used to show your events and is never shared." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더 데이터는 오직 일정을 표시하는 용도로만 사용되며 절대로 외부와 공유되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je agendagegevens worden alleen gebruikt om je activiteiten te tonen en worden nooit gedeeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do seu calendário são usados apenas para mostrar seus eventos e nunca são compartilhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные календаря используются только для показа событий и никуда не передаются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลปฏิทินของคุณใช้เฉพาะเพื่อแสดงเหตุการณ์และไม่เคยถูกแชร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim verileriniz yalnızca etkinliklerinizi göstermek için kullanılır ve asla paylaşılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的日历数据仅用于显示事件，绝不会被分享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的行事曆資料僅用於顯示事件，絕不會被分享。"
          }
        }
      }
    },
    "Your camera is never used without your consent, and nothing is recorded or stored." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 동의 없이는 카메라를 절대로 사용하지 않으며, 어떠한 내용도 녹화하거나 저장하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je camera wordt nooit zonder je toestemming gebruikt en er wordt niets opgenomen of opgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua câmera nunca é usada sem o seu consentimento, e nada é gravado ou armazenado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша камера не используется без согласия, ничего не записывается и не сохраняется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กล้องของคุณไม่ถูกใช้โดยไม่ได้รับความยินยอม และไม่มีอะไรถูกบันทึกหรือจัดเก็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameranız asla sizin izniniz olmadan kullanılmaz, hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未经您同意，相机不会被使用，且不会录制或存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未經你同意，相機不會被使用，且不會錄製或儲存任何內容。"
          }
        }
      }
    },
