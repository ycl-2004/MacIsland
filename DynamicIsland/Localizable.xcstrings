    "Use Light when the wallpaper is bright so titles and labels stay readable." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Hell bei hellem Hintergrundbild, damit Titel und Beschriftungen lesbar bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Claro cuando el fondo de pantalla sea brillante para que títulos y etiquetas se lean bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Clair si le fond d’écran est lumineux afin que les titres et libellés restent lisibles."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면이 밝을 때는 라이트를 선택하면 제목과 라벨이 잘 보입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Licht bij een heldere achtergrond, zodat titels en labels leesbaar blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz Jasny przy jasnej tapecie, aby tytuły i etykiety pozostały czytelne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Claro quando o papel de parede for claro para manter títulos e rótulos legíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Светлая», если обои светлые — тогда названия и подписи останутся читаемыми."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกแบบสว่างเมื่อวอลเปเปอร์สว่าง เพื่อให้ชื่อและป้ายกำกับอ่านได้ชัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar kağıdı açıksa Açık’ı seçin; böylece başlıklar ve etiketler okunaklı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберіть «Світла», якщо шпалери світлі — тоді назви та підписи залишаться читабельними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁纸较亮时请选择浅色，以便标题和标签保持清晰可读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌布較亮時請選擇淺色，以便標題與標籤保持清晰可讀。"
          }
        }
      }
    },
    "Use MacBook icon when on battery" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리 사용 시 MacBook 아이콘 사용"
          }
        },
        "nl" : {
